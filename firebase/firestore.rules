rules_version = '2';
// Perfil v1:
// usuarios/{uid}: fecha_creacion (timestamp del servidor, inmutable).
// personas/{uid}: nombres y apellidos (string, 1..80, no blancos/control).
// estudiantes/{uid}: id_plan (string fijo, referencia existente e inmutable).
// Los IDs solo viven en las rutas; no hay correo, contraseña ni roles.
// carreras y planes_estudio: referencias compartidas, sin escritura del cliente.
// Paso 3, prototipo local pendiente de publicar:
// materias/{id}: id_plan, codigo, nombre, semestre, area, min_aprobadas; solo lectura.
// materias/{id}/prerrequisitos/{idRequisito}: documento vacío, solo lectura.
// estudiantes/{uid}/estados/{idMateria}: solo estado = EN_CURSO o APROBADA.
// PENDIENTE se representa eliminando el registro. Oferta T2: documento único con revisión propia; reglas locales, no desplegadas.
// control_academico/revision: version_formato=1 y valor entero monotónico.
// TODO escritor académico (incluidos diario/preparación) debe incrementarlo
// atómicamente. Clientes anteriores conservan lectura, pero deben actualizarse
// para escribir. No requiere migrar ni reescribir estados personales existentes.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validName(value) {
      return value is string && value.size() >= 1 && value.size() <= 80
        && value.matches('.*[^\\s\\p{Z}].*')
        && !value.matches('.*[\\p{Cc}\\p{Zl}\\p{Zp}].*');
    }
    function validUser(data) {
      return data.keys().hasAll(['fecha_creacion'])
        && data.keys().hasOnly(['fecha_creacion'])
        && data.fecha_creacion is timestamp;
    }
    function validPerson(data) {
      return data.keys().hasAll(['nombres', 'apellidos'])
        && data.keys().hasOnly(['nombres', 'apellidos'])
        && validName(data.nombres) && validName(data.apellidos);
    }
    function validStudent(data) {
      return data.keys().hasAll(['id_plan']) && data.keys().hasOnly(['id_plan'])
        && data.id_plan is string && data.id_plan == 'sistemas-rm-615-2016'
        && exists(/databases/$(database)/documents/planes_estudio/sistemas-rm-615-2016)
        && get(/databases/$(database)/documents/planes_estudio/sistemas-rm-615-2016).data.id_carrera == 'ingenieria-sistemas'
        && exists(/databases/$(database)/documents/carreras/ingenieria-sistemas);
    }
    function completeRegistration(uid) {
      // Comprueba el estado FINAL del lote, no solo el documento que se escribe.
      return validUser(getAfter(/databases/$(database)/documents/usuarios/$(uid)).data)
        && validPerson(getAfter(/databases/$(database)/documents/personas/$(uid)).data)
        && validStudent(getAfter(/databases/$(database)/documents/estudiantes/$(uid)).data);
    }
    function academicProfile(uid) {
      // Para lecturas se comprueba el estado actual, no getAfter().
      return validUser(get(/databases/$(database)/documents/usuarios/$(uid)).data)
        && validPerson(get(/databases/$(database)/documents/personas/$(uid)).data)
        && validStudent(get(/databases/$(database)/documents/estudiantes/$(uid)).data);
    }
    function catalogSubject(idMateria) {
      return exists(/databases/$(database)/documents/materias/$(idMateria))
        && get(/databases/$(database)/documents/materias/$(idMateria)).data.id_plan == 'sistemas-rm-615-2016';
    }
    // T2: identities only, kept equal to the technical catalog by offer-catalog.test.cjs.
    function offerOwner(uid) {
      return isOwner(uid) && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function offerSubjectIds() {
      return [
        'fb1dab22-2348-551f-bc70-352b22c2ce2d',
        'd53b90f1-f469-5f3e-a3ae-c248f011f483',
        '316362c6-79fa-5021-ae3e-f6e65cf4101e',
        '3c61c8a7-263c-5c5a-8ebc-af022cf63574',
        '7f9cd4ef-7d44-535f-85da-822e18ddfe88',
        '8a5dca99-c7af-543a-a205-3a3acc392466',
        '35aed79d-8fcf-5544-86fb-c2297a89348c',
        '39de8258-5666-5535-b4cc-f490ecc9ae56',
        '68b64723-78a8-5d79-89e5-82938bf73036',
        '81fd3088-3596-55da-a2f7-a0f639d77a3a',
        '14f7e1d4-f314-571b-8202-3842d76b4092',
        '75b80182-a5ce-5593-a64d-46cfa1639931',
        '7e71fe1f-e423-519a-9cb1-0431235a80a1',
        '22e35e36-a80b-5b1d-ba24-450cd2ef76fb',
        '15cf174e-3fa1-5e93-837b-6c23314ecf3c',
        'cb49b20d-fffb-5101-8fa7-3a006de4bce7',
        '7cea96d9-7707-5220-b218-28a85fe4fa55',
        'b37ea8d5-fd45-53e8-90d5-bc6f9b6a2e07',
        '75649722-0bc9-5376-913c-e5547ce0853f',
        '07919ad2-0848-52b0-ab9d-deea107fcf5d',
        '73916614-ee2e-55bb-99a6-98b303044467',
        '52ef8872-be50-5ae6-8fd3-666a17e7bdfe',
        'f75d0bf8-a6fe-58b2-887b-3bf1101d6050',
        '914f1e8f-fabb-554a-8883-f375a8ab42fa',
        'dd101cb6-f7ec-5c52-ac3d-8341467559c0',
        'bc3b890d-71d2-5748-a046-7301819f821f',
        '7400ab4e-4575-5954-a22f-de2d6e91bb36',
        'a2bc5848-c781-5b6d-81d8-2bb5dc27a24d',
        '369ca5b9-b57f-5b01-91fe-4964b74fcf32',
        '516724b0-e561-5d2c-8058-f7735f72598f',
        '9a5192f7-0155-5615-8e4c-2b776b3c3af2',
        '2b13f519-e145-59c0-9d37-7d8344f2e961',
        '37661802-7a9d-54c8-b702-822791b84ab5',
        '224cbffa-b34f-5c8b-b47b-c54d922f7375',
        'd801219c-e55b-5c04-9039-38bd1504a11b',
        '26f25e52-a808-5059-ba91-02248ad8704b',
        '2f696856-c88d-56d5-b58c-31aa7406f91f',
        '95afd49b-4581-5424-b9d1-baf8d7e61e7a',
        '6ff4f553-8f54-5f53-9bfd-570fc75b4524',
        'b09a9ca1-585a-5903-9128-be27be9199c5',
        '23c9d223-e89a-50bf-8602-d56b44eabea5',
        '9ba7d046-8c4a-52f2-bf80-7bf786e61e8d',
        '9b6fce0a-f957-5a6b-880f-06e3a73cdd88',
        'ae0af14b-3066-5581-b8b8-b5ba02703eed',
        'b7bc3be4-dabb-5766-b8a4-b49035db8f48',
        'bf453970-36b5-5fa7-8d8a-68a88dacbb1e',
        '5f65c1fa-2c7d-59e7-8355-633fac532a10',
        '8af7e095-4108-5538-b453-498ca54eafb4',
        'a157d3e5-55cd-5d3e-8dd2-e46862e154ca',
        '97d17109-daf4-58eb-9304-b49a48df44e2'
      ];
    }
    function validOffer(data) {
      return data.keys().hasAll(['version_formato', 'id_plan', 'materias', 'revision', 'actualizado_en'])
        && data.keys().hasOnly(['version_formato', 'id_plan', 'materias', 'revision', 'actualizado_en'])
        && data.version_formato is int && data.version_formato == 1
        && data.id_plan == 'sistemas-rm-615-2016'
        && data.materias is list && data.materias.size() <= 50
        && data.materias.size() == data.materias.toSet().size()
        && data.materias.toSet().hasOnly(offerSubjectIds())
        && data.revision is int && data.revision > 0 && data.revision < 9223372036854775807
        && data.actualizado_en is timestamp && data.actualizado_en == request.time;
    }
    function validAcademicState(data) {
      return data.keys().hasAll(['estado']) && data.keys().hasOnly(['estado'])
        && data.estado is string && data.estado in ['EN_CURSO', 'APROBADA'];
    }
    function validAcademicRevision(data) {
      return data.keys().hasAll(['version_formato', 'valor'])
        && data.keys().hasOnly(['version_formato', 'valor'])
        && data.version_formato is int && data.version_formato == 1
        && data.valor is int && data.valor > 0 && data.valor < 9223372036854775807;
    }
    function advancesAcademicRevision(uid) {
      let revision = /databases/$(database)/documents/estudiantes/$(uid)/control_academico/revision;
      return validAcademicRevision(getAfter(revision).data)
        && ((!exists(revision) && getAfter(revision).data.valor == 1)
          || (exists(revision) && getAfter(revision).data.valor == get(revision).data.valor + 1));
    }
    // Preparación v1 local: controla acceso/esquema, no coherencia curricular.
    // El repositorio valida catálogo, huellas, deltas y conflictos del conjunto.
    function validPreparation(data) {
      return data.keys().hasAll(['version_formato', 'decision', 'actualizado_en'])
        && data.keys().hasOnly(['version_formato', 'decision', 'actualizado_en'])
        && data.version_formato is int && data.version_formato == 1
        && data.decision in ['POSPUESTO', 'CONFIRMADO']
        && data.actualizado_en is timestamp && data.actualizado_en == request.time;
    }
    function canSavePreparation(uid, data) {
      let journal = /databases/$(database)/documents/estudiantes/$(uid)/operaciones_historial/actual;
      return (data.decision == 'POSPUESTO'
          && (!existsAfter(journal) || getAfter(journal).data.estado != 'EN_PROGRESO'))
        || (data.decision == 'CONFIRMADO'
          && getAfter(journal).data.estado == 'COMPLETADA'
          && getAfter(journal).data.actualizado_en == request.time);
    }
    function validHistoryOperation(data) {
      let uuid = '[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}';
      return data.keys().hasAll(['version_formato', 'id_operacion', 'huella_base',
          'huella_objetivo', 'revision_preparacion', 'cambios', 'aplicados', 'estado', 'actualizado_en'])
        && data.keys().hasOnly(['version_formato', 'id_operacion', 'huella_base',
          'huella_objetivo', 'revision_preparacion', 'cambios', 'aplicados', 'estado', 'actualizado_en'])
        && data.version_formato is int && data.version_formato == 1
        && data.id_operacion is string && data.id_operacion.matches(uuid)
        && data.huella_base is string && data.huella_base.matches('[a-f0-9]{64}')
        && data.huella_objetivo is string && data.huella_objetivo.matches('[a-f0-9]{64}')
        && data.revision_preparacion is string
        && (data.revision_preparacion == 'AUSENTE'
          || data.revision_preparacion.matches('-?[0-9]{1,19}:[0-9]{1,9}'))
        && data.cambios is map && data.cambios.size() <= 50
        && data.cambios.values().hasOnly(['PA', 'PC', 'AP', 'AC', 'CP', 'CA'])
        && (data.cambios.size() == 0 || data.cambios.keys().join('|').matches(uuid + '(\\|' + uuid + ')*'))
        && data.aplicados is list && data.aplicados.size() == data.aplicados.toSet().size()
        && data.aplicados.toSet().hasOnly(data.cambios.keys())
        && data.estado in ['EN_PROGRESO', 'COMPLETADA', 'CANCELADA']
        && (data.estado != 'COMPLETADA' || data.aplicados.size() == data.cambios.size())
        && data.actualizado_en is timestamp && data.actualizado_en == request.time;
    }
    function startsHistoryOperation(data) {
      return data.estado == 'EN_PROGRESO' && data.aplicados.size() == 0;
    }
    function advancesHistoryOperation(before, after) {
      return (before.id_operacion != after.id_operacion
          && before.estado in ['COMPLETADA', 'CANCELADA'] && startsHistoryOperation(after))
        || (before.id_operacion == after.id_operacion && before.estado == 'EN_PROGRESO'
          && after.huella_base == before.huella_base && after.huella_objetivo == before.huella_objetivo
          && after.revision_preparacion == before.revision_preparacion && after.cambios == before.cambios
          && after.aplicados.toSet().hasAll(before.aplicados)
          && (after.estado != 'CANCELADA' || after.aplicados == before.aplicados));
    }
    match /usuarios/{uid} {
      allow get: if isOwner(uid);
      allow create: if isOwner(uid) && validUser(request.resource.data)
        && request.resource.data.fecha_creacion == request.time && completeRegistration(uid);
      allow update: if isOwner(uid) && validUser(request.resource.data)
        && request.resource.data.fecha_creacion == resource.data.fecha_creacion
        && completeRegistration(uid);
    }
    match /personas/{uid} {
      allow get: if isOwner(uid);
      allow create, update: if isOwner(uid) && validPerson(request.resource.data)
        && completeRegistration(uid);
    }
    match /estudiantes/{uid} {
      allow get: if isOwner(uid);
      allow create: if isOwner(uid) && validStudent(request.resource.data) && completeRegistration(uid);
      allow update: if isOwner(uid) && validStudent(request.resource.data)
        && (!('id_plan' in resource.data) || request.resource.data.id_plan == resource.data.id_plan)
        && completeRegistration(uid);
      // One document replaces the full selection atomically. Independent of academic revision.
      match /ofertas/actual {
        allow get: if offerOwner(uid) && academicProfile(uid);
        allow create: if offerOwner(uid) && completeRegistration(uid)
          && validOffer(request.resource.data) && request.resource.data.revision == 1;
        allow update: if offerOwner(uid) && completeRegistration(uid)
          && validOffer(request.resource.data)
          && request.resource.data.revision == resource.data.revision + 1;
        // No delete or list permission.
      }
      match /estados/{idMateria} {
        // No filtrar por materia en lecturas: permite consultar la colección propia
        // y diagnosticar registros huérfanos de una eventual operación administrativa.
        allow get, list: if isOwner(uid) && academicProfile(uid);
        allow create, update: if isOwner(uid) && completeRegistration(uid)
          && catalogSubject(idMateria) && validAcademicState(request.resource.data)
          && advancesAcademicRevision(uid);
        // Puede limpiar un estado aunque su materia haya sido retirada por Admin.
        allow delete: if isOwner(uid) && completeRegistration(uid) && advancesAcademicRevision(uid);
      }
      match /control_academico/revision {
        allow get: if isOwner(uid) && academicProfile(uid);
        allow create, update: if isOwner(uid) && completeRegistration(uid)
          && validAcademicRevision(request.resource.data) && advancesAcademicRevision(uid);
      }
      match /configuracion_academica/historial {
        allow get: if isOwner(uid) && academicProfile(uid);
        allow create, update: if isOwner(uid) && completeRegistration(uid)
          && validPreparation(request.resource.data) && canSavePreparation(uid, request.resource.data)
          && advancesAcademicRevision(uid);
      }
      match /operaciones_historial/actual {
        allow get: if isOwner(uid) && academicProfile(uid);
        allow create: if isOwner(uid) && completeRegistration(uid)
          && validHistoryOperation(request.resource.data) && startsHistoryOperation(request.resource.data)
          && advancesAcademicRevision(uid);
        allow update: if isOwner(uid) && completeRegistration(uid)
          && validHistoryOperation(request.resource.data)
          && advancesHistoryOperation(resource.data, request.resource.data) && advancesAcademicRevision(uid);
      }
    }
    match /carreras/{id} {
      allow get: if request.auth != null && id == 'ingenieria-sistemas';
    }
    match /planes_estudio/{id} {
      allow get: if request.auth != null && id == 'sistemas-rm-615-2016';
    }
    match /materias/{idMateria} {
      // La consulta de colección requiere where('id_plan', '==', planV1).
      allow get, list: if request.auth != null
        && resource.data.id_plan == 'sistemas-rm-615-2016';
      match /prerrequisitos/{idRequisito} {
        // El cargador de catálogo valida las relaciones. No hay escrituras cliente.
        allow get, list: if request.auth != null && catalogSubject(idMateria);
      }
    }
    // Sin listas de perfiles, borrados de perfil, escrituras de catálogo ni otros documentos de oferta.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
