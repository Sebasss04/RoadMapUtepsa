erDiagram
    %% Modelo logico normalizado propuesto. No es un esquema SQL desplegado.
    %% PK y FK expresan identidad y referencias conceptuales.
    %% Cuenta Auth externa: puede existir antes de completar el alta Firestore.
    %% Persona y perfil: uno de cada uno por usuario completamente registrado.
    CUENTA_AUTH ||--o| USUARIO : identifica
    USUARIO ||--|| PERSONA : tiene
    USUARIO ||--|| PERFIL_ESTUDIANTE : tiene
    CARRERA ||--|{ PLAN_ESTUDIO : agrupa
    PLAN_ESTUDIO ||--|{ MATERIA : contiene
    PLAN_ESTUDIO ||--o{ PERFIL_ESTUDIANTE : asignado_a
    MATERIA ||--o{ PRERREQUISITO : es_objetivo
    MATERIA ||--o{ PRERREQUISITO : es_requisito
    PERFIL_ESTUDIANTE ||--o{ ESTADO_ACADEMICO : registra
    MATERIA ||--o{ ESTADO_ACADEMICO : tiene_estado
    PERFIL_ESTUDIANTE ||--o| PREPARACION_HISTORIAL : decide
    PERFIL_ESTUDIANTE ||--o| OPERACION_HISTORIAL : conserva_ultima
    OPERACION_HISTORIAL ||--o{ CAMBIO_OPERACION_HISTORIAL : contiene_delta
    MATERIA ||--o{ CAMBIO_OPERACION_HISTORIAL : es_objetivo
    PERFIL_ESTUDIANTE ||--o| OFERTA_PERSONAL : registra
    OFERTA_PERSONAL ||--o{ OFERTA_MATERIA : incluye
    MATERIA ||--o{ OFERTA_MATERIA : es_ofertada

    CUENTA_AUTH {
        string uid PK "Externa a Firestore; credenciales en Authentication"
    }
    USUARIO {
        string uid PK,FK "Mismo UID de Authentication"
        timestamp fecha_creacion
    }
    PERSONA {
        string uid PK,FK "Referencia a USUARIO; identidad estable"
        string nombres
        string apellidos
    }
    PERFIL_ESTUDIANTE {
        string uid PK,FK "Referencia a USUARIO; sin roles adicionales"
        string id_plan FK
    }
    CARRERA {
        string id_carrera PK
        string nombre
    }
    PLAN_ESTUDIO {
        string id_plan PK
        string id_carrera FK
        string resolucion
        string fuente
    }
    MATERIA {
        string id_materia PK "Identificador global estable y opaco"
        string id_plan FK
        string codigo "Clave alternativa compuesta: id_plan y codigo"
        string nombre
        int semestre
        string area "BASICA, COMPLEMENTARIA, ESPECIALIDAD, ELECTIVA"
        int min_aprobadas "0 por defecto; STS-300 exige 40"
    }
    PRERREQUISITO {
        string id_objetivo PK,FK "Referencia MATERIA.id_materia"
        string id_requisito PK,FK "Referencia MATERIA.id_materia"
    }
    ESTADO_ACADEMICO {
        string uid PK,FK "Referencia PERFIL_ESTUDIANTE.uid"
        string id_materia PK,FK
        string estado "EN_CURSO o APROBADA; ausencia equivale a PENDIENTE"
    }
    PREPARACION_HISTORIAL {
        string uid PK,FK "Una decision actual por perfil; ausencia no equivale a cero aprobadas"
        int version_formato "1"
        string decision "POSPUESTO o CONFIRMADO; no certifica SAE"
        timestamp actualizado_en "Servidor; su revision distingue cambios concurrentes"
    }
    OPERACION_HISTORIAL {
        string uid PK,FK "Un espacio para la ultima operacion por perfil"
        string id_operacion UK "UUID nuevo solo al iniciar otra operacion"
        int version_formato "1"
        string huella_base "SHA-256 del conjunto de estados revisado"
        string huella_objetivo "SHA-256 del conjunto final propuesto"
        string revision_preparacion "Revision leida segundos:nanosegundos o AUSENTE; no FK"
        string estado "EN_PROGRESO, COMPLETADA o CANCELADA"
        timestamp actualizado_en "Servidor"
    }
    CAMBIO_OPERACION_HISTORIAL {
        string uid PK,FK "Referencia al espacio de OPERACION_HISTORIAL"
        string id_materia PK,FK
        string estado_anterior "PENDIENTE, EN_CURSO o APROBADA"
        string estado_nuevo "Distinto del anterior; no es el estado actual consultable"
        boolean aplicado "Progreso confirmado junto con el cambio de estado"
    }
    OFERTA_PERSONAL {
        string uid PK,FK
        timestamp fecha_actualizacion
    }
    OFERTA_MATERIA {
        string uid PK,FK "Referencia a OFERTA_PERSONAL.uid"
        string id_materia PK,FK
    }
    %% Unicidad adicional: MATERIA(id_plan, codigo).
    %% PRERREQUISITO: objetivo distinto de requisito; mismo plan; sin ciclos.
    %% Estados y ofertas solo referencian materias del plan del estudiante.
    %% OFERTA_MATERIA contiene solo claves: su existencia expresa inclusion.
    %% PENDIENTE se obtiene al no existir estado para una materia del plan.
    %% No persistir porcentajes, listas de aprobadas, habilitaciones ni recomendaciones.
    %% Preparacion y diario D implementados localmente; publicacion F pendiente.
    %% OPERACION_HISTORIAL solo se reemplaza tras COMPLETADA o CANCELADA.
    %% CAMBIO_OPERACION_HISTORIAL normaliza deltas, no duplica todo el historial.
    %% Firestore embebe los deltas en cambios y su progreso en aplicados del diario actual.
    %% Codigos PA/PC/AP/AC/CP/CA: P=PENDIENTE, C=EN_CURSO, A=APROBADA.
    %% De cero a 50 deltas; grupos transaccionales de hasta cinco con CAS completo.
    %% Borrador no enviado solo en memoria; cancelar diario no revierte estados aplicados.
    %% Oferta siguiente sigue futura y denegada para escrituras del cliente.

    %% Oferta unica actual: uid identifica la cabecera; (uid, id_materia) identifica inclusion.
    %% Cabecera ausente = oferta no registrada; cabecera sin inclusiones = guardada vacia.
