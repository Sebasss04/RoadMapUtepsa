flowchart TB
    TITLE["ESQUEMA FIRESTORE - 17/10/2026<br/>Perfil y catalogo academico publicados<br/>Preparacion D local; publicacion F pendiente; Oferta futura"]
    AUTH["Firebase Authentication - externo<br/>UID, correo de acceso, proveedores y contrasena"]
    DB["Cloud Firestore"]
    TITLE --> DB

    subgraph PRIVATE["Datos privados - propietario identificado por UID"]
        U["usuarios/{uid}<br/>fecha_creacion: timestamp"]
        P["personas/{uid}<br/>nombres: string<br/>apellidos: string"]
        S["estudiantes/{uid}<br/>id_plan: string"]
        E["estudiantes/{uid}/estados/{idMateria}<br/>estado: EN_CURSO o APROBADA"]
        HP["estudiantes/{uid}/configuracion_academica/historial<br/>version_formato: int = 1<br/>decision: POSPUESTO o CONFIRMADO<br/>actualizado_en: timestamp de servidor"]
        HO["estudiantes/{uid}/operaciones_historial/actual<br/>version_formato: int = 1; id_operacion: UUID<br/>huella_base, huella_objetivo: SHA-256<br/>revision_preparacion: segundos:nanosegundos o AUSENTE<br/>cambios: mapa ID a PA/PC/AP/AC/CP/CA<br/>aplicados: lista de IDs unicos<br/>estado: EN_PROGRESO, COMPLETADA o CANCELADA<br/>actualizado_en: timestamp de servidor"]
        O["FUTURO: estudiantes/{uid}/ofertas/actual<br/>fecha_actualizacion: timestamp"]
        OM["FUTURO: estudiantes/{uid}/ofertas/actual/materias/{idMateria}<br/>Documento sin campos: existencia = incluida"]
        S -->|subcoleccion| E
        S -->|subcoleccion| HP
        S -->|subcoleccion| HO
        S -->|subcoleccion| O
        O -->|subcoleccion| OM
    end

    subgraph CATALOG["Catalogo compartido - estudiantes solo leen"]
        C["carreras/{idCarrera}<br/>nombre: string"]
        PL["planes_estudio/{idPlan}<br/>id_carrera: string<br/>resolucion: string<br/>fuente: string"]
        M["materias/{idMateria}<br/>id_plan: string<br/>codigo: string<br/>nombre: string<br/>semestre: int<br/>area: string<br/>min_aprobadas: int"]
        R["materias/{idObjetivo}/prerrequisitos/{idRequisito}<br/>Documento sin campos: existencia = requisito"]
        M -->|subcoleccion| R
        PL -. id_carrera .-> C
        M -. id_plan .-> PL
        R -. idRequisito .-> M
    end

    DB --> U
    DB --> P
    DB --> S
    DB --> C
    DB --> PL
    DB --> M
    AUTH -. mismo_UID .-> U
    U -. mismo_UID .-> P
    U -. mismo_UID .-> S
    S -. id_plan .-> PL
    E -. idMateria .-> M
    OM -. idMateria .-> M

    DEFAULT["Sin documento de estado = PENDIENTE<br/>Volver a pendiente elimina el documento de estado<br/>Quitar una materia elimina su inclusion<br/>Sin cabecera = ausente; cabecera sin materias = guardada vacia"]
    DERIVED["Habilitacion y coherencia calculadas en memoria<br/>Avance y recomendaciones futuras; Oferta no implementada<br/>Sin arrays paralelos ni copias del catalogo por usuario"]
    RULES["Perfil, catalogo y estados: reglas publicadas<br/>Preparacion D: reglas locales comprobadas, publicacion F pendiente<br/>Propietario por UID; campos, tipos y referencias estrictos<br/>Materias del plan; catalogo sin escritura del estudiante<br/>Oferta denegada; coherencia curricular validada en repositorio"]
    RECOVERY["Preparacion D implementada localmente<br/>Borrador no enviado solo en memoria por UID<br/>Diario de ultima operacion: deltas, no otro historial<br/>Transacciones comparan 50 estados, marcador y diario<br/>Grupos de hasta cinco; relectura antes de anunciar exito<br/>Recuperar no reaplica grupos; cancelar no revierte estados<br/>P/C/A = PENDIENTE/EN_CURSO/APROBADA"]
    LOAD["Carga controlada del catalogo fuera de la app<br/>Validar codigos unicos por plan y grafo sin ciclos<br/>Sin rol administrador dentro de la app"]
    ATOMIC["Alta Firestore: usuario + persona + perfil en un lote<br/>Authentication es una operacion independiente<br/>Si falta perfil, reintentar sin crear otra cuenta"]
    LEGEND["Flecha continua = ubicacion o subcoleccion<br/>Flecha punteada = referencia logica, no FK automatica<br/>IDs en la ruta: no repetirlos como campos"]
    E -.-> DEFAULT
    HP -.-> RECOVERY
    HO -.-> RECOVERY
    E -.-> DERIVED
    OM -.-> DERIVED
    M -.-> DERIVED
    RULES -.-> DB
    LOAD -.-> CATALOG
    ATOMIC -.-> PRIVATE
    LEGEND --- TITLE

    classDef private fill:#E3F2FD,stroke:#1565C0,color:#102A43
    classDef catalog fill:#E8F5E9,stroke:#2E7D32,color:#163B1A
    classDef note fill:#FFF8E1,stroke:#B7791F,color:#513500
    class U,P,S,E,HP,HO,O,OM private
    class C,PL,M,R catalog
    class DEFAULT,DERIVED,RULES,RECOVERY,LOAD,ATOMIC,LEGEND note
